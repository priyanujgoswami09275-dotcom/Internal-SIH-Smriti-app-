# Elder-Care Cognitive Companion — environment variables
# Copy to .env and fill in secrets before running.

# --- Database / Cache ---
# Safe placeholder only — copy to .env and fill in. Never commit real credentials.
# Cloud (Supabase example shape; percent-encode special password chars, @ -> %40):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Local demo (do not point production here): postgresql+psycopg://USER@localhost:5432/eldercare
# Supabase shared pooler session mode: username postgres.<project_ref>, port 5432,
# default database name (Studio/MCP only show the default DB):
#   postgresql+psycopg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Alembic reads DATABASE_URL from the process env (not .env) — export it when migrating:
#   export DATABASE_URL=... && python -m alembic upgrade head
REDIS_URL=redis://redis:6379/0

# --- Security ---
# ENVIRONMENT=production refuses placeholder secrets and CORS=*
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_HERE

# Comma-separated origins in production, e.g. https://care.example.org
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100
ENABLE_BACKGROUND_JOBS=true

# --- Speech: Bhashini (Phase 8) ---
# Provider: auto (ai4bharat -> bhashini -> mock by configured creds) | ai4bharat | bhashini | mock
LANGUAGE_SERVICE_PROVIDER=auto
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# --- Speech: AI4Bharat via Hugging Face Inference API (alternate NMT/ASR/TTS) ---
# Auto chain: ai4bharat first when HUGGINGFACE_API_TOKEN is set, then bhashini, then mock.
# Supported: assamese, bengali, bodo, manipuri, nepali, hindi, english.
# Khasi and Mizo are NOT supported by these models — the frontend shows
# "not yet available" for them (UnsupportedLanguageError -> HTTP 400).
HUGGINGFACE_API_TOKEN=
# Inference API base. Default is the Inference Providers router; the AI4Bharat
# models are NOT currently served serverless — point this at a dedicated
# Inference Endpoint URL to actually run them.
HUGGINGFACE_INFERENCE_BASE=https://router.huggingface.co/hf-inference

# --- LLM: OpenRouter (default provider, FREE TIER ONLY) ---
# Provider: auto (infers from key prefix) | openrouter | anthropic
LLM_PROVIDER=auto
LLM_MAX_TOKENS=300
LLM_AUTO_FALLBACK=true
# Get a free key at https://openrouter.ai/keys (sk-or-...).
# With OPENROUTER_FREE_ONLY=true only ':free' model slugs are permitted.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_ONLY=true

# --- LLM: Anthropic Claude (alternative; unused while OpenRouter key is set) ---
ANTHROPIC_API_KEY=            # or export CLAUDE_API_KEY (legacy name)
ANTHROPIC_VERSION=2023-06-01
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_MAX_TOKENS=300

# --- Embeddings (RAG) ---
# local: multilingual-e5-small (semantic; needs `pip install sentence-transformers`
# plus deps in requirements.txt — heavy). heuristic: deterministic fallback, no deps.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=1536

# --- Notifications (reminder escalation / alert fan-out, Phase 11) ---
# console (default, local mock — logs + records deliveries) | sms | fcm | email
NOTIFICATION_PROVIDER=console

# --- Adaptive Success ML (Phase B-01, shadow-only) ---
# Empty = disabled (shadow_probability always null, shadow_reason="disabled").
# Rules remain the sole difficulty authority; this only fills nullable shadow_* fields.
# Relative filename under backend/ml_models/adaptive_success/ (must end in .joblib).
# Requires scikit-learn matching the artifact (pinned in requirements.txt).
ADAPTIVE_SHADOW_MODEL=bootstrap.joblib
