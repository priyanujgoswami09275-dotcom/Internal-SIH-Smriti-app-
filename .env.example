# Elder-Care Cognitive Companion — environment variables
# Copy to .env for local use, then inject real secrets through your secret manager.
# Never commit .env or print its contents.

# --- Application metadata / API ---
PROJECT_NAME=Elder-Care Cognitive Companion
PROJECT_VERSION=0.1.0
API_V1_STR=/api/v1
API_BASE_URL=http://localhost:8000

# --- Database / cache ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/eldercare
REDIS_URL=redis://redis:6379/0

# --- Security / runtime ---
# ENVIRONMENT=production refuses placeholder secrets and CORS=*
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_HERE
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100
ENABLE_BACKGROUND_JOBS=true

# --- Language selection ---
LANGUAGE_SET=["assamese","bengali","hindi","english","mizo","manipuri","khasi","bodo","garo","nepali"]
DEFAULT_LANGUAGE=english

# --- Speech: provider selection ---
# auto: sarvam -> ai4bharat -> bhashini -> mock, based on configured credentials.
# With all provider keys empty, auto uses deterministic simulated speech.
LANGUAGE_SERVICE_PROVIDER=auto

# --- Speech: Sarvam ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Speech: Bhashini ULCA ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# --- Speech: AI4Bharat via Hugging Face Inference API ---
# The default router does not currently serve these models. Set
# HUGGINGFACE_INFERENCE_BASE to a dedicated Inference Endpoint to run them.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_INFERENCE_BASE=https://router.huggingface.co/hf-inference

# --- LLM: provider selection / timeout / fallback ---
# auto: openrouter -> anthropic, inferred from configured key material.
LLM_PROVIDER=auto
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=45
LLM_AUTO_FALLBACK=true

# --- LLM: OpenRouter (default provider, FREE TIER ONLY) ---
# With OPENROUTER_FREE_ONLY=true only ':free' model slugs are permitted.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_ONLY=true
OPENROUTER_APP_URL=https://github.com/sih26003/eldercare
OPENROUTER_APP_TITLE=Elder-Care Cognitive Companion (SIH26003)

# --- LLM: Anthropic Claude (alternative) ---
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_VERSION=2023-06-01
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_MAX_TOKENS=300

# --- Embeddings (RAG) ---
# heuristic: deterministic local fallback; local: sentence-transformers;
# openai: hosted embeddings and requires OPENAI_API_KEY.
EMBEDDING_PROVIDER=heuristic
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=

# --- Adaptive difficulty / research training ---
# Optional serialized shadow model artifact. Empty means no shadow inference.
ADAPTIVE_SHADOW_MODEL=
# Required only for explicitly authorized real-mode adaptive training reads.
ADAPTIVE_TRAIN_DATABASE_URL=

# --- Notifications / reminder delivery ---
# console is the honest default. The current FCM adapter logs/failed-audits
# attempts and does not send; FCM_* values below are reserved for a real adapter.
NOTIFICATION_PROVIDER=console
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Reminder engine ---
REMINDER_TIMEZONE=Asia/Kolkata
REMINDER_ESCALATE_MINUTES=10
REMINDER_MISSED_MINUTES=60
REMINDER_GENERATION_SECONDS=60

# --- Live smoke test (optional) ---
# The smoke walk creates synthetic records; use only an approved demo/disposable DB.
SMOKE_CLINICIAN_PHONE=
SMOKE_CLINICIAN_PASSWORD=

# --- Opt-in live provider tests (no secret is needed for normal CI) ---
RUN_LIVE_SARVAM=
RUN_LIVE_AI4BHARAT=

# --- Opt-in PostgreSQL migration test ---
RUN_RISK_MIGRATION_POSTGRES=
RISK_MIGRATION_POSTGRES_URL=

# --- Flutter compile-time defines (passed with --dart-define, not read from .env) ---
# API_BASE_URL is shared by mobile and dashboard; dashboard release builds require it.
# DEV_MENU=true enables the mobile debug role menu.
# LIVE_API=true enables the opt-in mobile live API test.
