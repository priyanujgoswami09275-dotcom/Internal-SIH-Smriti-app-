{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "plugins/graphify.js",
    "opencode-supabase"
  ],
  "provider": {
    "tokenharbor": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Token Harbor",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1",
        "apiKey": "{env:TOKENHARBOR_API_KEY}"
      },
      "models": {
        "th-orchestra": {
          "name": "TH Orchestra"
        }
      }
    }
  },
  "model": "tokenharbor/th-orchestra",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=lulbpdoezapjvoarniyg&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    }
  }
}
